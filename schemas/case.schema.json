{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marmot-protocol.github.io/agent-p1p/schemas/case.schema.json",
  "title": "case",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_version": {
      "const": 2
    },
    "intake_label": {
      "const": "pip-ok"
    },
    "state": {
      "enum": [
        "PLANNING",
        "WAITING_HUMAN",
        "BUILDING",
        "REVIEWING",
        "FINAL_REVIEW",
        "SHADOW_READY",
        "COMPLETED",
        "BLOCKED",
        "ESCALATED",
        "ABANDONED"
      ]
    },
    "plan_version": {
      "type": "integer",
      "minimum": 0
    },
    "remediation_round": {
      "type": "integer",
      "minimum": 0
    },
    "pr_number": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "current_pr_head": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "case_id",
    "repository",
    "issue_number",
    "workflow_version",
    "intake_label",
    "state",
    "plan_version",
    "remediation_round",
    "pr_number",
    "current_pr_head",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}

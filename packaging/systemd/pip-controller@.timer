[Unit]
Description=Run the Pip active controller cycle for %i

[Timer]
OnBootSec=2min
OnUnitInactiveSec=15s
AccuracySec=1s
RandomizedDelaySec=2s
# Monotonic timers must ignore stamps left by older Persistent=true units.
Persistent=false
Unit=pip-controller@%i.service

[Install]
WantedBy=timers.target

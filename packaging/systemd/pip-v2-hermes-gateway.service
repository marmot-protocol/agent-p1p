[Unit]
Description=Pip v2 dedicated Hermes Kanban dispatcher
Documentation=https://github.com/marmot-protocol/agent-p1p
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/pip-v2/hermes/.pip-v2-root.json

[Service]
Type=simple
User=pip-v2-control
Group=pip-v2-control
Environment=HOME=/var/lib/pip-v2/hermes/home
Environment=HERMES_HOME=/var/lib/pip-v2/hermes
Environment=HERMES_KANBAN_HOME=/var/lib/pip-v2/hermes
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/pip-v2
ExecStart=/usr/local/bin/hermes gateway run --no-supervise
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/pip-v2/current /var/lib/pip-v2/repositories
ReadWritePaths=/var/lib/pip-v2/hermes /var/lib/pip-v2/worktrees
InaccessiblePaths=/var/lib/pip-v2/ledger.db /var/lib/pip-v2/artifacts /var/lib/pip-v2/provider-home
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

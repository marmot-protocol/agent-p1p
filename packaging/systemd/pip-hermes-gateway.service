[Unit]
Description=Pip dedicated Hermes Kanban dispatcher
Documentation=https://github.com/marmot-protocol/agent-p1p
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/pip/worktrees
ConditionPathExists=/var/lib/pip/hermes/.pip-root.json
ConditionPathIsMountPoint=/var/lib/pip/worktrees

[Service]
Type=simple
User=pip-control
Group=pip-control
Environment=HOME=/var/lib/pip/hermes/home
Environment=HERMES_HOME=/var/lib/pip/hermes
Environment=HERMES_KANBAN_HOME=/var/lib/pip/hermes
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/pip
ExecStart=/usr/local/bin/hermes gateway run --external-supervisor
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/pip/current /var/lib/pip/repositories /var/lib/pip/worktrees
ReadWritePaths=/var/lib/pip/hermes
ReadWritePaths=/var/lib/pip/worktrees/hermes-scratch
InaccessiblePaths=/var/lib/pip/ledger.db /var/lib/pip/artifacts /var/lib/pip/provider-home
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

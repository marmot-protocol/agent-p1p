[Unit]
Description=Run the Pip GitHub webhook spool consumer for %i
Documentation=https://github.com/marmot-protocol/agent-p1p

[Timer]
OnBootSec=30s
OnUnitInactiveSec=5s
RandomizedDelaySec=1s
AccuracySec=1s
# Monotonic timers must ignore stamps left by older Persistent=true units.
Persistent=false
Unit=pip-webhook-consumer@%i.service

[Install]
WantedBy=timers.target

[Unit]
Description=Periodically run Pip non-dispatching reconciliation

[Timer]
OnBootSec=2min
OnUnitInactiveSec=5min
RandomizedDelaySec=15s
# Monotonic timers must ignore stamps left by older Persistent=true units.
Persistent=false
Unit=pip-shadow-reconcile.service

[Install]
WantedBy=timers.target
